// Video limits per app (free accounts). One place to edit.
// Keys match PlatformDef.id in platform_registry.dart.
// maxSeconds == null means no practical length limit.
// verified == false means the number is a guess: test a real upload.

class VideoLimit {
  final String id;
  final String label;
  final int? maxSeconds;
  final int? maxMB;
  final String hint;
  final bool verified;
  final bool indiaOnly;

  const VideoLimit({
    required this.id,
    required this.label,
    required this.maxSeconds,
    required this.maxMB,
    required this.hint,
    this.verified = true,
    this.indiaOnly = false,
  });
}

const List<int> kRecordLengthOptions = [15, 30, 45, 60, 120, 180];
const int kDefaultRecordSeconds = 60;

const Map<String, VideoLimit> kVideoLimits = {
  'whatsapp': VideoLimit(
    id: 'whatsapp',
    label: 'WhatsApp Status',
    maxSeconds: 90,
    maxMB: 16,
    hint: 'WhatsApp Status 30s',
    verified: false, // reports disagree: 30, 60, 90
  ),
  'instagram': VideoLimit(
    id: 'instagram',
    label: 'Instagram Stories',
    maxSeconds: 60,
    maxMB: null,
    hint: 'Instagram Reels 15 to 30s',
  ),
  'youtube': VideoLimit(
    id: 'youtube',
    label: 'YouTube Shorts',
    maxSeconds: 180,
    maxMB: null,
    hint: 'YouTube Shorts up to 3 min',
  ),
  'facebook': VideoLimit(
    id: 'facebook',
    label: 'Facebook Reels',
    maxSeconds: null,
    maxMB: null,
    hint: 'Facebook Reels any length',
  ),
  'telegram': VideoLimit(
    id: 'telegram',
    label: 'Telegram',
    maxSeconds: null,
    maxMB: 2000,
    hint: 'Telegram up to 2 GB',
  ),
  'snapchat': VideoLimit(
    id: 'snapchat',
    label: 'Snapchat Spotlight',
    maxSeconds: 60,
    maxMB: 500,
    hint: 'Snapchat Spotlight up to 60s',
  ),
  'x': VideoLimit(
    id: 'x',
    label: 'X',
    maxSeconds: 140,
