import 'dart:async';
import 'dart:math';

import 'package:hive_flutter/hive_flutter.dart';
import 'package:local_auth/local_auth.dart';

class SecurityService {
  SecurityService._internal();

  static final SecurityService instance = SecurityService._internal();

  factory SecurityService() => instance;

  static const String boxName = 'security';

  static const String _pinEnabledKey = 'pin_enabled';
  static const String _pinEnabledCamelKey = 'pinEnabled';
  static const String _oldPinEnabledKey = '_pinEnabled';

  static const String _pinKey = 'pin';
  static const String _appPinKey = 'app_pin';
  static const String _pinCodeKey = 'pinCode';
  static const String _generatedPinKey = 'generatedPin';

  static const String _faceEnabledKey = 'face_enabled';
  static const String _faceEnabledCamelKey = 'faceEnabled';
  static const String _biometricEnabledKey = 'biometric_enabled';
  static const String _biometricEnabledCamelKey = 'biometricEnabled';
  static const String _faceIdEnabledKey = 'faceIdEnabled';

  static const String _pinFailuresKey = 'pin_failures';
  static const String _faceFailuresKey = 'face_failures';
  static const String _lockoutUntilKey = 'lockout_until';
  static const String _timeoutMinutesKey = 'timeout_minutes';
  static const String _lastActivityKey = 'last_activity';

  static const int _maxPinFailures = 5;
  static const int _maxFaceFailures = 3;
  static const int _defaultTimeoutMinutes = 5;
  static const int _lockoutSeconds = 60;

  final LocalAuthentication _auth = LocalAuthentication();

  Box<dynamic>? _box;

  Future<void> init() async {
    await load();
  }

  Future<void> initialize() async {
    await load();
  }

  Future<void> load() async {
    if (Hive.isBoxOpen(boxName)) {
      _box = Hive.box<dynamic>(boxName);
    } else {
      _box = await Hive.openBox<dynamic>(boxName);
    }

    _normalizeOldKeys();
  }

  Box<dynamic>? _boxSync() {
    try {
      if (_box != null && _box!.isOpen) return _box;
      if (Hive.isBoxOpen(boxName)) {
        _box = Hive.box<dynamic>(boxName);
        return _box;
      }
    } catch (_) {
      return null;
    }

    return null;
  }

  void _normalizeOldKeys() {
    final box = _boxSync();
    if (box == null) return;

    final oldPinEnabled = _readBoolAny([
      _pinEnabledKey,
      _pinEnabledCamelKey,
      _oldPinEnabledKey,
    ]);

    if (oldPinEnabled != null) {
      box.put(_pinEnabledKey, oldPinEnabled);
      box.put(_pinEnabledCamelKey, oldPinEnabled);
      box.put(_oldPinEnabledKey, oldPinEnabled);
    }

    final oldPin = _readStringAny([
      _pinKey,
      _appPinKey,
      _pinCodeKey,
      _generatedPinKey,
    ]);

    if (oldPin != null && oldPin.trim().isNotEmpty) {
      box.put(_pinKey, oldPin.trim());
      box.put(_appPinKey, oldPin.trim());
    }

    final oldFaceEnabled = _readBoolAny([
      _faceEnabledKey,
      _faceEnabledCamelKey,
      _biometricEnabledKey,
      _biometricEnabledCamelKey,
      _faceIdEnabledKey,
    ]);

    if (oldFaceEnabled != null) {
      box.put(_faceEnabledKey, oldFaceEnabled);
      box.put(_faceEnabledCamelKey, oldFaceEnabled);
      box.put(_biometricEnabledKey, oldFaceEnabled);
      box.put(_biometricEnabledCamelKey, oldFaceEnabled);
      box.put(_faceIdEnabledKey, oldFaceEnabled);
    }

    if (box.get(_timeoutMinutesKey) == null) {
      box.put(_timeoutMinutesKey, _defaultTimeoutMinutes);
    }

    box.flush();
  }

  // ---------------------------------------------------------------------------
  // Lock state
  // ---------------------------------------------------------------------------

  bool get anyLockEnabled => anyLockEnabledSync;

  bool get anyLockEnabledSync {
    return pinEnabled || faceEnabled;
  }

  Future<bool> loadAnyLockEnabled() async {
    await load();
    return anyLockEnabledSync;
  }

  bool get isLockedOut {
    final box = _boxSync();
    if (box == null) return false;

    final until = _readInt(_lockoutUntilKey) ?? 0;
    if (until <= 0) return false;

    final now = DateTime.now().millisecondsSinceEpoch;
    if (now >= until) {
      box.delete(_lockoutUntilKey);
      box.flush();
      return false;
    }

    return true;
  }

  Duration get lockoutRemaining {
    final box = _boxSync();
    if (box == null) return Duration.zero;

    final until = _readInt(_lockoutUntilKey) ?? 0;
    final now = DateTime.now().millisecondsSinceEpoch;
    final remaining = until - now;

    if (remaining <= 0) return Duration.zero;

    return Duration(milliseconds: remaining);
  }

  bool recordActivity() {
    final box = _boxSync();
    if (box == null) return false;

    box.put(_lastActivityKey, DateTime.now().millisecondsSinceEpoch);
    box.flush();
    return true;
  }

  bool get isTimedOut {
    final box = _boxSync();
    if (box == null) return false;

    final last = _readInt(_lastActivityKey);
    if (last == null || last <= 0) return false;

    final elapsed = DateTime.now().millisecondsSinceEpoch - last;
    return elapsed >= Duration(minutes: timeoutMinutes).inMilliseconds;
  }

  int get timeoutMinutes {
    return _readInt(_timeoutMinutesKey) ?? _defaultTimeoutMinutes;
  }

  bool setTimeout(dynamic value) {
    final box = _boxSync();
    if (box == null) return false;

    int minutes = _defaultTimeoutMinutes;

    if (value is int) {
      minutes = value;
    } else if (value is double) {
      minutes = value.round();
    } else if (value is Duration) {
      minutes = value.inMinutes;
    } else if (value is String) {
      minutes = int.tryParse(value) ?? _defaultTimeoutMinutes;
    }

    if (minutes < 1) minutes = 1;
    if (minutes > 120) minutes = 120;

    box.put(_timeoutMinutesKey, minutes);
    box.flush();
    return true;
  }

  // ---------------------------------------------------------------------------
  // PIN
  // ---------------------------------------------------------------------------

  bool get pinEnabled {
    final enabled = _readBoolAny([
          _pinEnabledKey,
          _pinEnabledCamelKey,
          _oldPinEnabledKey,
        ]) ??
        false;

    final savedPin = getPin();
    return enabled && savedPin != null && savedPin.trim().isNotEmpty;
  }

  bool get isPinEnabled => pinEnabled;

  Future<bool> loadPinEnabled() async {
    await load();
    return pinEnabled;
  }

  String? setPinEnabled(bool enabled, [String? pin]) {
    if (enabled) {
      return enablePin(pin: pin);
    }

    disablePin();
    return null;
  }

  String enablePin({String? pin, bool forceNew = false}) {
    final box = _boxSync();
    if (box == null) {
      return pin ?? _createSixDigitPin();
    }

    _normalizeOldKeys();

    final existingPin = getPin();

    // Critical fix:
    // Do NOT regenerate PIN on init/rebuild/toggle if one already exists.
    final pinToSave = (!forceNew && existingPin != null && existingPin.trim().isNotEmpty)
        ? existingPin.trim()
        : (pin != null && pin.trim().isNotEmpty)
            ? pin.trim()
            : _createSixDigitPin();

    box.put(_pinKey, pinToSave);
    box.put(_appPinKey, pinToSave);
    box.put(_pinEnabledKey, true);
    box.put(_pinEnabledCamelKey, true);
    box.put(_oldPinEnabledKey, true);
    box.flush();

    return pinToSave;
  }

  String createPin() {
    return enablePin(forceNew: true);
  }

  String generatePin() {
    return enablePin(forceNew: true);
  }

  String regeneratePin() {
    return enablePin(forceNew: true);
  }

  String resetPin() {
    return enablePin(forceNew: true);
  }

  String getOrCreatePin() {
    return enablePin();
  }

  bool disablePin() {
    final box = _boxSync();
    if (box == null) return false;

    box.put(_pinEnabledKey, false);
    box.put(_pinEnabledCamelKey, false);
    box.put(_oldPinEnabledKey, false);

    box.delete(_pinKey);
    box.delete(_appPinKey);
    box.delete(_pinCodeKey);
    box.delete(_generatedPinKey);

    resetPinFailures();
    box.flush();
    return true;
  }

  bool clearPin() => disablePin();

  bool deletePin() => disablePin();

  String? getPin() {
    return _readStringAny([
      _pinKey,
      _appPinKey,
      _pinCodeKey,
      _generatedPinKey,
    ]);
  }

  String? getCurrentPin() => getPin();

  String? currentPin() => getPin();

  bool verifyPin(String value) {
    if (isLockedOut) return false;

    final savedPin = getPin();
    if (!pinEnabled || savedPin == null) return false;

    return value.trim() == savedPin.trim();
  }

  bool checkPin(String value) => verifyPin(value);

  bool validatePin(String value) => verifyPin(value);

  int get pinFailures {
    return _readInt(_pinFailuresKey) ?? 0;
  }

  bool resetPinFailures() {
    final box = _boxSync();
    if (box == null) return false;

    box.put(_pinFailuresKey, 0);
    box.delete(_lockoutUntilKey);
    box.flush();
    return true;
  }

  bool recordPinFailure() {
    final box = _boxSync();
    if (box == null) return false;

    final next = pinFailures + 1;
    box.put(_pinFailuresKey, next);

    if (next >= _maxPinFailures) {
      _startLockout();
    }

    box.flush();
    return true;
  }

  // ---------------------------------------------------------------------------
  // Face ID / Biometrics
  // ---------------------------------------------------------------------------

  bool get faceEnabled {
    return _readBoolAny([
          _faceEnabledKey,
          _faceEnabledCamelKey,
          _biometricEnabledKey,
          _biometricEnabledCamelKey,
          _faceIdEnabledKey,
        ]) ??
        false;
  }

  bool get faceIdEnabled => faceEnabled;

  bool get biometricEnabled => faceEnabled;

  bool get biometricEnabledSync => faceEnabled;

  bool enableFaceId() {
    return setFaceIdEnabled(true);
  }

  bool enableFaceID() {
    return setFaceIdEnabled(true);
  }

  bool disableFaceId() {
    return setFaceIdEnabled(false);
  }

  bool disableFaceID() {
    return setFaceIdEnabled(false);
  }

  bool setFaceIdEnabled(bool enabled) {
    return setBiometricEnabled(enabled);
  }

  bool setFaceIDEnabled(bool enabled) {
    return setBiometricEnabled(enabled);
  }

  bool setBiometricsEnabled(bool enabled) {
    return setBiometricEnabled(enabled);
  }

  bool setBiometricEnabled(bool enabled) {
    final box = _boxSync();
    if (box == null) return false;

    box.put(_faceEnabledKey, enabled);
    box.put(_faceEnabledCamelKey, enabled);
    box.put(_biometricEnabledKey, enabled);
    box.put(_biometricEnabledCamelKey, enabled);
    box.put(_faceIdEnabledKey, enabled);

    if (!enabled) {
      resetFaceFailures();
    }

    box.flush();
    return enabled;
  }

  Future<bool> isBiometricAvailable() async {
    return canUseBiometrics();
  }

  Future<bool> canUseBiometrics() async {
    try {
      final supported = await _auth.isDeviceSupported();
      final canCheck = await _auth.canCheckBiometrics;
      final available = await _auth.getAvailableBiometrics();

      return supported && canCheck && available.isNotEmpty;
    } catch (_) {
      return false;
    }
  }

  Future<bool> authenticateFace() async {
    return authenticateWithBiometrics();
  }

  Future<bool> authenticateFaceId() async {
    return authenticateWithBiometrics();
  }

  Future<bool> authenticateFaceID() async {
    return authenticateWithBiometrics();
  }

  Future<bool> authenticate() async {
    return authenticateWithBiometrics();
  }

  Future<bool> unlockWithBiometrics() async {
    return authenticateWithBiometrics();
  }

  Future<bool> authenticateWithBiometrics({
    String localizedReason = 'Unlock 1Social',
    Duration timeout = const Duration(seconds: 15),
  }) async {
    if (isLockedOut) return false;

    try {
      final available = await canUseBiometrics();
      if (!available) return false;

      return await _auth
          .authenticate(
            localizedReason: localizedReason,
            options: const AuthenticationOptions(
              stickyAuth: true,
              biometricOnly: true,
            ),
          )
          .timeout(
            timeout,
            onTimeout: () => false,
          );
    } on TimeoutException {
      return false;
    } catch (_) {
      return false;
    }
  }

  int get faceFailures {
    return _readInt(_faceFailuresKey) ?? 0;
  }

  bool resetFaceFailures() {
    final box = _boxSync();
    if (box == null) return false;

    box.put(_faceFailuresKey, 0);
    box.delete(_lockoutUntilKey);
    box.flush();
    return true;
  }

  bool recordFaceFailure() {
    final box = _boxSync();
    if (box == null) return false;

    final next = faceFailures + 1;
    box.put(_faceFailuresKey, next);

    if (next >= _maxFaceFailures) {
      _startLockout();
    }

    box.flush();
    return true;
  }

  // ---------------------------------------------------------------------------
  // Internal helpers
  // ---------------------------------------------------------------------------

  void _startLockout() {
    final box = _boxSync();
    if (box == null) return;

    final until = DateTime.now()
        .add(const Duration(seconds: _lockoutSeconds))
        .millisecondsSinceEpoch;

    box.put(_lockoutUntilKey, until);
    box.flush();
  }

  String _createSixDigitPin() {
    final random = Random.secure();
    return List.generate(6, (_) => random.nextInt(10)).join();
  }

  bool? _readBoolAny(List<String> keys) {
    final box = _boxSync();
    if (box == null) return null;

    for (final key in keys) {
      final value = box.get(key);

      if (value is bool) return value;

      if (value is int) return value != 0;

      if (value is String) {
        final lowered = value.trim().toLowerCase();
        if (lowered == 'true') return true;
        if (lowered == 'false') return false;
      }
    }

    return null;
  }

  String? _readStringAny(List<String> keys) {
    final box = _boxSync();
    if (box == null) return null;

    for (final key in keys) {
      final value = box.get(key);

      if (value is String && value.trim().isNotEmpty) {
        return value.trim();
      }

      if (value is int) {
        return value.toString().padLeft(6, '0');
      }
    }

    return null;
  }

  int? _readInt(String key) {
    final box = _boxSync();
    if (box == null) return null;

    final value = box.get(key);

    if (value is int) return value;

    if (value is double) return value.round();

    if (value is String) return int.tryParse(value.trim());

    return null;
  }
}
