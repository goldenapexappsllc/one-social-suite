import 'dart:async';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import '../services/security_service.dart';
import '../theme/app_theme.dart';
import '../widgets/brand_logo.dart';

// ---------------------------------------------------------------------------
// LockScreen -- handles Face ID, PIN, or both (Face ID first, PIN fallback).
// ---------------------------------------------------------------------------
class LockScreen extends StatefulWidget {
  const LockScreen({super.key, required this.onUnlock});
  final VoidCallback onUnlock;

  @override
  State<LockScreen> createState() => _LockScreenState();
}

enum _Mode { faceId, pin, lockedOut }

class _LockScreenState extends State<LockScreen> {
  final SecurityService _sec = SecurityService.instance;

  _Mode _mode = _Mode.faceId;
  String _entered = '';
  String _errorMsg = '';
  bool _faceAttempting = false;
  Timer? _lockoutTimer;
  int _lockoutSecondsLeft = 0;

  @override
  void initState() {
    super.initState();
    _sec.resetFaceFailures();
    _determineMode();
  }

  @override
  void dispose() {
    _lockoutTimer?.cancel();
    super.dispose();
  }

  void _determineMode() {
    if (_sec.isLockedOut) {
      _startLockoutCountdown();
      return;
    }
    if (_sec.faceEnabled) {
      setState(() => _mode = _Mode.faceId);
      WidgetsBinding.instance
          .addPostFrameCallback((_) => _tryFaceId());
    } else {
      setState(() => _mode = _Mode.pin);
    }
  }

  // ---------------------------------------------------------------------------
  // Face ID
  // ---------------------------------------------------------------------------
  Future<void> _tryFaceId() async {
    if (_faceAttempting || !mounted) return;
    setState(() {
      _faceAttempting = true;
      _errorMsg = '';
    });
    final ok = await _sec.authenticateFace();
    if (!mounted) return;
    setState(() => _faceAttempting = false);

    if (ok) {
      _sec.resetFaceFailures();
      _sec.recordActivity();
      widget.onUnlock();
      return;
    }

    _sec.recordFaceFailure();
    // After 2 Face ID failures, fall back to PIN if enabled
    if (_sec.faceFailures >= 2 && _sec.pinEnabled) {
      setState(() {
        _mode = _Mode.pin;
        _errorMsg = 'Use your PIN instead.';
      });
    } else if (_sec.faceFailures >= 2) {
      setState(() => _errorMsg = 'Face ID unavailable. Try again.');
    } else {
      setState(() => _errorMsg = 'Face ID failed. Try again.');
    }
  }

  // ---------------------------------------------------------------------------
  // PIN
  // ---------------------------------------------------------------------------
  void _onDigit(String d) {
    if (_sec.isLockedOut) return;
    if (_entered.length >= 6) return;
    setState(() {
      _entered += d;
      _errorMsg = '';
    });
    if (_entered.length == 6) _submitPin();
  }

  void _onBackspace() {
    if (_entered.isEmpty) return;
    setState(() => _entered = _entered.substring(0, _entered.length - 1));
  }

  void _submitPin() {
    final ok = _sec.validatePin(_entered);
    if (!mounted) return;

    if (ok) {
      _sec.resetPinFailures();
      _sec.recordActivity();
      HapticFeedback.lightImpact();
      widget.onUnlock();
      return;
    }

    HapticFeedback.heavyImpact();
    _sec.recordPinFailure();

    if (_sec.isLockedOut) {
      _startLockoutCountdown();
      setState(() => _entered = '');
      return;
    }

    final remaining = 5 - _sec.pinFailures;
    setState(() {
      _entered = '';
      _errorMsg = remaining > 0
          ? 'Incorrect PIN. $remaining attempt${remaining == 1 ? "" : "s"} remaining.'
          : 'Incorrect PIN.';
    });
  }

  void _startLockoutCountdown() {
    _lockoutTimer?.cancel();
    setState(() {
      _mode = _Mode.lockedOut;
      _lockoutSecondsLeft =
          _sec.lockoutRemaining.inSeconds.clamp(1, 300);
    });
    _lockoutTimer =
        Timer.periodic(const Duration(seconds: 1), (t) {
      if (!mounted) {
        t.cancel();
        return;
      }
      setState(() => _lockoutSecondsLeft--);
      if (_lockoutSecondsLeft <= 0) {
        t.cancel();
        _sec.resetPinFailures();
        setState(() {
          _mode = _sec.faceEnabled ? _Mode.faceId : _Mode.pin;
          _errorMsg = '';
        });
        if (_sec.faceEnabled) _tryFaceId();
      }
    });
  }

  // ---------------------------------------------------------------------------
  // Build
  // ---------------------------------------------------------------------------
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: AppColors.black,
      body: SafeArea(
        child: Column(
          children: <Widget>[
            const SizedBox(height: 48),
            const BrandLogo(width: 220, height: 118),
            const SizedBox(height: 36),
            const Icon(Icons.lock_outline, color: AppColors.gold, size: 36),
            const SizedBox(height: 12),
            const Text(
              '1Social is locked',
              style: TextStyle(
                  color: Colors.white,
                  fontSize: 18,
                  fontWeight: FontWeight.w700),
            ),
            const SizedBox(height: 32),
            if (_mode == _Mode.lockedOut) _buildLockedOut(),
            if (_mode == _Mode.faceId)    _buildFaceId(),
            if (_mode == _Mode.pin)       _buildPin(),
          ],
        ),
      ),
    );
  }

  Widget _buildFaceId() {
    return Column(
      children: <Widget>[
        Text(
          _errorMsg.isEmpty
              ? 'Unlock with Face ID'
              : _errorMsg,
          textAlign: TextAlign.center,
          style: TextStyle(
              color: _errorMsg.isEmpty
                  ? AppColors.textMuted
                  : Colors.orange,
              fontSize: 14),
        ),
        const SizedBox(height: 28),
        SizedBox(
          width: 200,
          child: ElevatedButton.icon(
            onPressed: _faceAttempting ? null : _tryFaceId,
            style: ElevatedButton.styleFrom(
              backgroundColor: AppColors.gold,
              disabledBackgroundColor:
                  AppColors.gold.withValues(alpha: 0.4),
              padding: const EdgeInsets.symmetric(vertical: 14),
            ),
            icon: const Icon(Icons.face, color: Colors.black, size: 20),
            label: Text(
              _faceAttempting ? 'Unlocking...' : 'Unlock',
              style: const TextStyle(
                  color: Colors.black, fontWeight: FontWeight.bold),
            ),
          ),
        ),
        if (_sec.pinEnabled) ...<Widget>[
          const SizedBox(height: 16),
          TextButton(
            onPressed: () => setState(() {
              _mode = _Mode.pin;
              _errorMsg = '';
            }),
            child: const Text('Use PIN instead',
                style: TextStyle(color: AppColors.textMuted)),
          ),
        ],
      ],
    );
  }

  Widget _buildPin() {
    return Expanded(
      child: Column(
        children: <Widget>[
          if (_errorMsg.isNotEmpty)
            Text(_errorMsg,
                textAlign: TextAlign.center,
                style: const TextStyle(color: Colors.orange, fontSize: 13)),
          const SizedBox(height: 8),
          const Text('Enter your 6-digit PIN',
              style: TextStyle(color: AppColors.textMuted, fontSize: 14)),
          const SizedBox(height: 24),
          // 6-dot indicator
          Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: List<Widget>.generate(6, (i) {
              final filled = i < _entered.length;
              return Container(
                margin: const EdgeInsets.symmetric(horizontal: 6),
                width: 14,
                height: 14,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  color: filled ? AppColors.gold : Colors.transparent,
                  border: Border.all(
                      color: filled ? AppColors.gold : AppColors.border,
                      width: 1.5),
                ),
              );
            }),
          ),
          const SizedBox(height: 32),
          // Keypad
          Expanded(
            child: Padding(
              padding: const EdgeInsets.symmetric(horizontal: 48),
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: <Widget>[
                  for (final row in <List<String>>[
                    <String>['1', '2', '3'],
                    <String>['4', '5', '6'],
                    <String>['7', '8', '9'],
                    <String>['', '0', 'del'],
                  ])
                    Padding(
                      padding: const EdgeInsets.only(bottom: 10),
                      child: Row(
                        mainAxisAlignment: MainAxisAlignment.spaceBetween,
                        children: row.map((String k) {
                          if (k.isEmpty) return const Expanded(child: SizedBox());
                          if (k == 'del') {
                            return Expanded(
                              child: _KeyButton(
                                onTap: _onBackspace,
                                child: const Icon(Icons.backspace_outlined,
                                    color: AppColors.gold, size: 22),
                              ),
                            );
                          }
                          return Expanded(
                            child: _KeyButton(
                              onTap: () => _onDigit(k),
                              child: Text(k,
                                  style: const TextStyle(
                                      color: Colors.white,
                                      fontSize: 24,
                                      fontWeight: FontWeight.w500)),
                            ),
                          );
                        }).toList(),
                      ),
                    ),
                ],
              ),
            ),
          ),
          if (_sec.faceEnabled) ...<Widget>[
            TextButton.icon(
              onPressed: () {
                setState(() {
                  _mode = _Mode.faceId;
                  _entered = '';
                  _errorMsg = '';
                });
                _tryFaceId();
              },
              icon: const Icon(Icons.face, color: AppColors.textMuted, size: 18),
              label: const Text('Use Face ID',
                  style: TextStyle(color: AppColors.textMuted, fontSize: 13)),
            ),
          ],
          const SizedBox(height: 24),
        ],
      ),
    );
  }

  Widget _buildLockedOut() {
    final m = _lockoutSecondsLeft ~/ 60;
    final s = _lockoutSecondsLeft % 60;
    final display = m > 0
        ? '$m:${s.toString().padLeft(2, "0")}'
        : '${s}s';
    return Column(
      children: <Widget>[
        const Icon(Icons.block, color: Colors.red, size: 40),
        const SizedBox(height: 12),
        const Text('Too many incorrect attempts',
            style: TextStyle(
                color: Colors.white,
                fontSize: 15,
                fontWeight: FontWeight.w600)),
        const SizedBox(height: 8),
        Text('Try again in $display',
            style: const TextStyle(
                color: AppColors.textMuted, fontSize: 13)),
      ],
    );
  }
}

// ---------------------------------------------------------------------------
// Keypad button
// ---------------------------------------------------------------------------
class _KeyButton extends StatelessWidget {
  const _KeyButton({required this.onTap, required this.child});
  final Widget child;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 4),
      child: AspectRatio(
        aspectRatio: 1.4,
        child: Material(
          color: Colors.transparent,
          child: InkWell(
            onTap: onTap,
            borderRadius: BorderRadius.circular(14),
            splashColor: AppColors.gold.withValues(alpha: 0.12),
            child: Container(
              decoration: BoxDecoration(
                color: AppColors.surface,
                borderRadius: BorderRadius.circular(14),
                border: Border.all(color: AppColors.border),
              ),
              alignment: Alignment.center,
              child: child,
            ),
          ),
        ),
      ),
    );
  }
}
