import 'dart:async';
import 'dart:math';

import 'package:hive_flutter/hive_flutter.dart';
import 'package:local_auth/local_auth.dart';

class SecurityService {
  SecurityService._internal();

  static final SecurityService instance = SecurityService._internal();

  factory SecurityService() => instance;

  static const String boxName = 'security';

  static const String _pinEnabledKey = 'pin_enabled';
  static const String _pinEnabledCamelKey = 'pinEnabled';
  static const String _oldPinEnabledKey = '_pinEnabled';

  static const String _pinKey = 'pin';
  static const String _appPinKey = 'app_pin';
  static const String _pinCodeKey = 'pinCode';
  static const String _generatedPinKey = 'generatedPin';

  static const String _biometricEnabledKey = 'biometric_enabled';
  static const String _biometricEnabledCamelKey = 'biometricEnabled';
  static const String _faceIdEnabledKey = 'faceIdEnabled';

  final LocalAuthentication _auth = LocalAuthentication();
  Box<dynamic>? _box;

  Future<void> init() async {
    final box = await _boxAsync();
    await _normalizeOldKeys(box);
  }

  Future<void> initialize() => init();

  Box<dynamic>? _boxSync() {
    try {
      if (_box != null && _box!.isOpen) return _box;
      if (Hive.isBoxOpen(boxName)) {
        _box = Hive.box<dynamic>(boxName);
        return _box;
      }
    } catch (_) {
      return null;
    }
    return null;
  }

  Future<Box<dynamic>> _boxAsync() async {
    final opened = _boxSync();
    if (opened != null) return opened;

    if (Hive.isBoxOpen(boxName)) {
      _box = Hive.box<dynamic>(boxName);
    } else {
      _box = await Hive.openBox<dynamic>(boxName);
    }
    return _box!;
  }

  Future<void> _normalizeOldKeys(Box<dynamic> box) async {
    final oldPinEnabled = _readBoolAny(box, [
      _pinEnabledKey,
      _pinEnabledCamelKey,
      _oldPinEnabledKey,
    ]);

    if (oldPinEnabled != null) {
      await box.put(_pinEnabledKey, oldPinEnabled);
      await box.put(_pinEnabledCamelKey, oldPinEnabled);
    }

    final oldPin = _readStringAny(box, [
      _pinKey,
      _appPinKey,
      _pinCodeKey,
      _generatedPinKey,
    ]);

    if (oldPin != null && oldPin.trim().isNotEmpty) {
      await box.put(_pinKey, oldPin.trim());
    }

    final oldBiometricEnabled = _readBoolAny(box, [
      _biometricEnabledKey,
      _biometricEnabledCamelKey,
      _faceIdEnabledKey,
    ]);

    if (oldBiometricEnabled != null) {
      await box.put(_biometricEnabledKey, oldBiometricEnabled);
      await box.put(_biometricEnabledCamelKey, oldBiometricEnabled);
      await box.put(_faceIdEnabledKey, oldBiometricEnabled);
    }

    await box.flush();
  }

  bool get pinEnabled => pinEnabledSync;
  bool get isPinEnabled => pinEnabledSync;

  bool get pinEnabledSync {
    final box = _boxSync();
    if (box == null) return false;

    final enabled = _readBoolAny(box, [
          _pinEnabledKey,
          _pinEnabledCamelKey,
          _oldPinEnabledKey,
        ]) ??
        false;

    final pin = _readStringAny(box, [
      _pinKey,
      _appPinKey,
      _pinCodeKey,
      _generatedPinKey,
    ]);

    return enabled && pin != null && pin.trim().isNotEmpty;
  }

  bool get biometricEnabled => biometricEnabledSync;
  bool get faceIdEnabled => biometricEnabledSync;

  bool get biometricEnabledSync {
    final box = _boxSync();
    if (box == null) return false;

    return _readBoolAny(box, [
          _biometricEnabledKey,
          _biometricEnabledCamelKey,
          _faceIdEnabledKey,
        ]) ??
        false;
  }

  bool get anyLockEnabled => anyLockEnabledSync;

  bool get anyLockEnabledSync {
    return pinEnabledSync || biometricEnabledSync;
  }

  Future<bool> loadPinEnabled() async {
    await init();
    return pinEnabledSync;
  }

  Future<bool> loadAnyLockEnabled() async {
    await init();
    return anyLockEnabledSync;
  }

  Future<String?> setPinEnabled(bool enabled) async {
    if (enabled) {
      return enablePin();
    }

    await disablePin();
    return null;
  }

  Future<String> enablePin({bool forceNew = false}) async {
    final box = await _boxAsync();
    await _normalizeOldKeys(box);

    final existingPin = _readStringAny(box, [
      _pinKey,
      _appPinKey,
      _pinCodeKey,
      _generatedPinKey,
    ]);

    // Critical fix:
    // If a PIN already exists, do NOT generate a fresh one during rebuild/initState.
    if (!forceNew && existingPin != null && existingPin.trim().isNotEmpty) {
      await box.put(_pinEnabledKey, true);
      await box.put(_pinEnabledCamelKey, true);
      await box.put(_pinKey, existingPin.trim());
      await box.flush();
      return existingPin.trim();
    }

    final newPin = _createSixDigitPin();

    await box.put(_pinKey, newPin);
    await box.put(_appPinKey, newPin);
    await box.put(_pinEnabledKey, true);
    await box.put(_pinEnabledCamelKey, true);
    await box.flush();

    return newPin;
  }

  Future<String> createPin() => enablePin(forceNew: true);
  Future<String> generatePin() => enablePin(forceNew: true);
  Future<String> regeneratePin() => enablePin(forceNew: true);
  Future<String> resetPin() => enablePin(forceNew: true);
  Future<String> getOrCreatePin() => enablePin();

  Future<void> disablePin() async {
    final box = await _boxAsync();

    await box.put(_pinEnabledKey, false);
    await box.put(_pinEnabledCamelKey, false);
    await box.put(_oldPinEnabledKey, false);

    await box.delete(_pinKey);
    await box.delete(_appPinKey);
    await box.delete(_pinCodeKey);
    await box.delete(_generatedPinKey);

    await box.flush();
  }

  Future<void> clearPin() => disablePin();
  Future<void> deletePin() => disablePin();

  Future<String?> getPin() async {
    final box = await _boxAsync();
    await _normalizeOldKeys(box);

    return _readStringAny(box, [
      _pinKey,
      _appPinKey,
      _pinCodeKey,
      _generatedPinKey,
    ]);
  }

  Future<String?> getCurrentPin() => getPin();
  Future<String?> currentPin() => getPin();

  Future<bool> verifyPin(String value) async {
    final pin = await getPin();
    return pinEnabledSync && pin != null && value.trim() == pin.trim();
  }

  Future<bool> checkPin(String value) => verifyPin(value);
  Future<bool> validatePin(String value) => verifyPin(value);

  Future<bool> setBiometricEnabled(bool enabled) async {
    final box = await _boxAsync();

    await box.put(_biometricEnabledKey, enabled);
    await box.put(_biometricEnabledCamelKey, enabled);
    await box.put(_faceIdEnabledKey, enabled);
    await box.flush();

    return enabled;
  }

  Future<bool> setBiometricsEnabled(bool enabled) => setBiometricEnabled(enabled);
  Future<bool> setFaceIdEnabled(bool enabled) => setBiometricEnabled(enabled);
  Future<bool> setFaceIDEnabled(bool enabled) => setBiometricEnabled(enabled);

  Future<bool> canUseBiometrics() async {
    try {
      final supported = await _auth.isDeviceSupported();
      final canCheck = await _auth.canCheckBiometrics;
      final available = await _auth.getAvailableBiometrics();

      return supported && canCheck && available.isNotEmpty;
    } catch (_) {
      return false;
    }
  }

  Future<bool> authenticateWithBiometrics({
    String localizedReason = 'Unlock 1Social',
    Duration timeout = const Duration(seconds: 15),
  }) async {
    try {
      final canUse = await canUseBiometrics();
      if (!canUse) return false;

      return await _auth
          .authenticate(
            localizedReason: localizedReason,
            options: const AuthenticationOptions(
              stickyAuth: true,
              biometricOnly: true,
            ),
          )
          .timeout(
            timeout,
            onTimeout: () => false,
          );
    } on TimeoutException {
      return false;
    } catch (_) {
      return false;
    }
  }

  Future<bool> authenticate() => authenticateWithBiometrics();
  Future<bool> unlockWithBiometrics() => authenticateWithBiometrics();
  Future<bool> authenticateFaceId() => authenticateWithBiometrics();
  Future<bool> authenticateFaceID() => authenticateWithBiometrics();

  String _createSixDigitPin() {
    final random = Random.secure();
    return List.generate(6, (_) => random.nextInt(10)).join();
  }

  bool? _readBoolAny(Box<dynamic> box, List<String> keys) {
    for (final key in keys) {
      final value = box.get(key);

      if (value is bool) return value;

      if (value is int) return value != 0;

      if (value is String) {
        final lowered = value.trim().toLowerCase();
        if (lowered == 'true') return true;
        if (lowered == 'false') return false;
      }
    }

    return null;
  }

  String? _readStringAny(Box<dynamic> box, List<String> keys) {
    for (final key in keys) {
      final value = box.get(key);

      if (value is String && value.trim().isNotEmpty) {
        return value.trim();
      }

      if (value is int) {
        return value.toString().padLeft(6, '0');
      }
    }

    return null;
  }
}
