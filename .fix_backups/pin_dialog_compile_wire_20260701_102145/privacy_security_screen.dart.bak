import 'package:flutter/material.dart';
import '../services/security_service.dart';
import '../theme/app_theme.dart';
import 'policy_screen.dart';
import 'package:flutter/services.dart';

// ---------------------------------------------------------------------------
// Privacy & Security tab -- merged per spec.
// Security section (PIN + Face ID + timeout) at top.
// Existing Privacy dashboard content below.
// ---------------------------------------------------------------------------
class PrivacySecurityScreen extends StatefulWidget {
  const PrivacySecurityScreen({super.key});

  @override
  State<PrivacySecurityScreen> createState() => _PrivacySecurityScreenState();
}

class _PrivacySecurityScreenState extends State<PrivacySecurityScreen> {
  final SecurityService _sec = SecurityService.instance;

  bool _pinEnabled = false;
  bool _faceEnabled = false;
  int _timeout = 1;
  bool _biometricAvailable = false;
  bool _savingPin = false;

  @override
  void initState() {
    super.initState();
    _pinEnabled = _sec.pinEnabled;
    _faceEnabled = _sec.faceEnabled;
    _timeout = _sec.timeoutMinutes;
    _sec.isBiometricAvailable().then((v) {
      if (mounted) setState(() => _biometricAvailable = v);
    });
  }

  // ---------------------------------------------------------------------------
  // PIN flow
  // ---------------------------------------------------------------------------

  /// Shows the disclaimer modal. Returns true if user tapped "I Understand".
  Future<bool> _showPinDisclaimer() async {
    final result = await showDialog<bool>(
      context: context,
      barrierDismissible: false,
      builder: (ctx) => AlertDialog(
        backgroundColor: AppColors.surface,
        shape: RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(20),
          side: const BorderSide(color: AppColors.gold, width: 1.5),
        ),
        title: const Row(
          children: <Widget>[
            Icon(Icons.lock_outline, color: AppColors.gold, size: 24),
            SizedBox(width: 10),
            Text(
              'Before You Set a PIN',
              style: TextStyle(
                color: AppColors.gold,
                fontWeight: FontWeight.bold,
                fontSize: 17,
              ),
            ),
          ],
        ),
        content: const SingleChildScrollView(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: <Widget>[
              Text(
                'Your PIN is stored only on this device in your '
                'iPhone\'s secure Keychain. It is never transmitted '
                'to 1Social, AppForge LLC, or any third party -- ever.',
                style: TextStyle(
                  color: Colors.white,
                  fontSize: 14,
                  height: 1.5,
                ),
              ),
              SizedBox(height: 14),
              Row(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: <Widget>[
                  Icon(
                    Icons.warning_amber_outlined,
                    color: Colors.orange,
                    size: 18,
                  ),
                  SizedBox(width: 8),
                  Expanded(
                    child: Text(
                      'If you forget your PIN, neither 1Social nor '
                      'AppForge LLC can unlock the app or recover your '
                      'PIN. No exceptions.',
                      style: TextStyle(
                        color: Colors.orange,
                        fontSize: 13,
                        height: 1.5,
                      ),
                    ),
                  ),
                ],
              ),
              SizedBox(height: 14),
              Text(
                'The only recovery option is to delete and reinstall '
                'the app, which will permanently erase all local data '
                'including your drafts and history.',
                style: TextStyle(
                  color: Colors.white,
                  fontSize: 14,
                  height: 1.5,
                ),
              ),
              SizedBox(height: 10),
              Text(
                'Please store your PIN somewhere safe.',
                style: TextStyle(
                  color: AppColors.gold,
                  fontSize: 14,
                  fontWeight: FontWeight.w600,
                ),
              ),
            ],
          ),
        ),
        actions: <Widget>[
          TextButton(
            onPressed: () => Navigator.of(ctx).pop(false),
            child: const Text(
              'Cancel',
              style: TextStyle(color: AppColors.textMuted),
            ),
          ),
          ElevatedButton(
            onPressed: () => Navigator.of(ctx).pop(true),
            style: ElevatedButton.styleFrom(
              backgroundColor: AppColors.gold,
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(12),
              ),
            ),
            child: const Text(
              'I Understand -- Set My PIN',
              style: TextStyle(
                color: Colors.black,
                fontWeight: FontWeight.bold,
                fontSize: 13,
              ),
            ),
          ),
        ],
      ),
    );
    return result ?? false;
  }

  /// Shows the generated PIN to the user exactly once.
  Future<bool> _showPinReveal(String pin) async {
    final result = await showDialog<bool>(
      context: context,
      barrierDismissible: false,
      builder: (ctx) => AlertDialog(
        backgroundColor: AppColors.surface,
        shape: RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(20),
          side: const BorderSide(color: AppColors.gold, width: 1.5),
        ),
        title: const Text(
          'Your 1Social Key',
          style: TextStyle(
            color: AppColors.gold,
            fontWeight: FontWeight.bold,
            fontSize: 18,
          ),
        ),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: <Widget>[
            const Text(
              'This is your 6-digit PIN. Write it down now -- '
              'it will never be shown again.',
              textAlign: TextAlign.center,
              style: TextStyle(
                color: AppColors.textMuted,
                fontSize: 13,
                height: 1.5,
              ),
            ),
            const SizedBox(height: 24),
            // Display PIN digits
            Row(
              mainAxisAlignment: MainAxisAlignment.center,
              children: pin
                  .split('')
                  .map(
                    (d) => Container(
                      margin: const EdgeInsets.symmetric(horizontal: 5),
                      width: 38,
                      height: 46,
                      decoration: BoxDecoration(
                        color: AppColors.black,
                        borderRadius: BorderRadius.circular(10),
                        border: Border.all(color: AppColors.gold, width: 1.5),
                      ),
                      alignment: Alignment.center,
                      child: Text(
                        d,
                        style: const TextStyle(
                          color: AppColors.gold,
                          fontSize: 22,
                          fontWeight: FontWeight.w900,
                        ),
                      ),
                    ),
                  )
                  .toList(),
            ),
            const SizedBox(height: 20),
            Container(
              padding: const EdgeInsets.all(12),
              decoration: BoxDecoration(
                color: Colors.orange.withValues(alpha: 0.1),
                borderRadius: BorderRadius.circular(10),
                border: Border.all(color: Colors.orange.withValues(alpha: 0.5)),
              ),
              child: const Row(
                children: <Widget>[
                  Icon(Icons.info_outline, color: Colors.orange, size: 16),
                  SizedBox(width: 8),
                  Expanded(
                    child: Text(
                      '1Social cannot recover this PIN if lost.',
                      style: TextStyle(
                        color: Colors.orange,
                        fontSize: 12,
                        fontWeight: FontWeight.w500,
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ],
        ),
        actions: <Widget>[
          ElevatedButton(
            onPressed: () => Navigator.of(ctx).pop(true),
            style: ElevatedButton.styleFrom(
              backgroundColor: AppColors.gold,
              minimumSize: const Size(double.infinity, 44),
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(12),
              ),
            ),
            child: const Text(
              "I've Saved My PIN -- Activate Lock",
              style: TextStyle(
                color: Colors.black,
                fontWeight: FontWeight.bold,
                fontSize: 13,
              ),
            ),
          ),
        ],
      ),
    );
    return result ?? false;
  }

  Future<void> _togglePin(bool value) async {
    final bool enabled = value;
    await _runUserPinToggle(enabled);
  }

  Future<void> _toggleFaceId(bool value) async {
    if (value) {
      if (!_biometricAvailable) {
        if (!mounted) return;
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('Face ID is not available on this device.'),
          ),
        );
        return;
      }
      // Trigger Face ID once to confirm it works before enabling
      final ok = await _sec.authenticateFace();
      if (!ok || !mounted) return;
      _sec.enableFaceId();
      setState(() => _faceEnabled = true);
    } else {
      // Require PIN confirmation before disabling Face ID
      if (_sec.pinEnabled) {
        final pin = await _showPinEntryDialog();
        if (pin == null || !mounted) return;
        final valid = _sec.validatePin(pin);
        if (!valid || !mounted) return;
      }
      _sec.disableFaceId();
      setState(() => _faceEnabled = false);
    }
  }

  Future<String?> _showPinEntryDialog() async {
    String entered = '';
    return showDialog<String>(
      context: context,
      builder: (ctx) => StatefulBuilder(
        builder: (ctx2, setS) => AlertDialog(
          backgroundColor: AppColors.surface,
          title: const Text(
            'Confirm your PIN',
            style: TextStyle(color: AppColors.gold),
          ),
          content: TextField(
            autofocus: true,
            obscureText: true,
            maxLength: 6,
            keyboardType: TextInputType.number,
            style: const TextStyle(color: Colors.white, letterSpacing: 8),
            decoration: const InputDecoration(
              hintText: '------',
              hintStyle: TextStyle(color: AppColors.textMuted),
              counterText: '',
              enabledBorder: UnderlineInputBorder(
                borderSide: BorderSide(color: AppColors.border),
              ),
              focusedBorder: UnderlineInputBorder(
                borderSide: BorderSide(color: AppColors.gold),
              ),
            ),
            onChanged: (v) => entered = v,
          ),
          actions: <Widget>[
            TextButton(
              onPressed: () => Navigator.of(ctx).pop(null),
              child: const Text(
                'Cancel',
                style: TextStyle(color: AppColors.textMuted),
              ),
            ),
            ElevatedButton(
              onPressed: () => Navigator.of(ctx).pop(entered),
              style: ElevatedButton.styleFrom(backgroundColor: AppColors.gold),
              child: const Text(
                'Confirm',
                style: TextStyle(
                  color: Colors.black,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  // ---------------------------------------------------------------------------
  // Build
  // ---------------------------------------------------------------------------

  Future<String?> _showCreatePinDialog() async {
    final pinController = TextEditingController();
    final confirmController = TextEditingController();

    String? errorText;
    bool obscurePin = true;

    try {
      return await showDialog<String>(
        context: context,
        barrierDismissible: false,
        builder: (dialogContext) {
          return StatefulBuilder(
            builder: (context, setDialogState) {
              void savePin() {
                final pin = pinController.text.trim();
                final confirmPin = confirmController.text.trim();

                if (!SecurityService.instance.isValidSixDigitPin(pin)) {
                  setDialogState(() {
                    errorText = 'Enter exactly 6 digits.';
                  });
                  return;
                }

                if (pin != confirmPin) {
                  setDialogState(() {
                    errorText = 'PINs do not match.';
                  });
                  return;
                }

                Navigator.of(dialogContext).pop(pin);
              }

              return AlertDialog(
                title: const Text('Create 6-digit PIN'),
                content: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    const Text(
                      'Choose a 6-digit PIN you will remember. This stays only on this device.',
                    ),
                    const SizedBox(height: 16),
                    TextField(
                      controller: pinController,
                      autofocus: true,
                      obscureText: obscurePin,
                      keyboardType: TextInputType.number,
                      maxLength: 6,
                      inputFormatters: const [
                        FilteringTextInputFormatter.digitsOnly,
                        LengthLimitingTextInputFormatter(6),
                      ],
                      decoration: const InputDecoration(
                        labelText: 'New PIN',
                        counterText: '',
                        border: OutlineInputBorder(),
                      ),
                    ),
                    const SizedBox(height: 12),
                    TextField(
                      controller: confirmController,
                      obscureText: obscurePin,
                      keyboardType: TextInputType.number,
                      maxLength: 6,
                      inputFormatters: const [
                        FilteringTextInputFormatter.digitsOnly,
                        LengthLimitingTextInputFormatter(6),
                      ],
                      decoration: const InputDecoration(
                        labelText: 'Confirm PIN',
                        counterText: '',
                        border: OutlineInputBorder(),
                      ),
                      onSubmitted: (_) => savePin(),
                    ),
                    const SizedBox(height: 8),
                    Row(
                      children: [
                        Checkbox(
                          value: !obscurePin,
                          onChanged: (value) {
                            setDialogState(() {
                              obscurePin = !(value ?? false);
                            });
                          },
                        ),
                        const Text('Show PIN'),
                      ],
                    ),
                    if (errorText != null) ...[
                      const SizedBox(height: 8),
                      Text(
                        errorText!,
                        style: const TextStyle(color: Colors.red),
                      ),
                    ],
                  ],
                ),
                actions: [
                  TextButton(
                    onPressed: () {
                      Navigator.of(dialogContext).pop(null);
                    },
                    child: const Text('Cancel'),
                  ),
                  ElevatedButton(
                    onPressed: savePin,
                    child: const Text('Save PIN'),
                  ),
                ],
              );
            },
          );
        },
      );
    } finally {
      pinController.dispose();
      confirmController.dispose();
    }
  }

  void _refreshSecurityStateAfterPinChange() {
    if (!mounted) return;

    setState(() {
      _pinEnabled = SecurityService.instance.pinEnabled;
      _faceEnabled = SecurityService.instance.faceEnabled;
    });
  }

  Future<void> _runUserPinToggle(bool enabled) async {
    final service = SecurityService.instance;

    if (!enabled) {
      service.disablePin();
      _refreshSecurityStateAfterPinChange();

      if (!mounted) return;
      ScaffoldMessenger.of(
        context,
      ).showSnackBar(const SnackBar(content: Text('PIN lock turned off.')));
      return;
    }

    final pin = await _showCreatePinDialog();

    if (!mounted) return;

    if (pin == null) {
      // User canceled. Keep PIN off.
      service.disablePin();
      _refreshSecurityStateAfterPinChange();
      return;
    }

    final saved = service.setCustomPin(pin);

    _refreshSecurityStateAfterPinChange();

    if (!mounted) return;

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(
          saved ? 'PIN lock turned on.' : 'PIN must be exactly 6 digits.',
        ),
      ),
    );
  }

  Future<void> _handlePinToggle(bool enabled) async {
    await _runUserPinToggle(enabled);
  }

  @override
  Widget build(BuildContext context) {
    return Container(
      color: AppColors.black,
      child: SafeArea(
        child: SingleChildScrollView(
          padding: const EdgeInsets.fromLTRB(16, 16, 16, 32),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: <Widget>[
              // Header
              const Center(
                child: Icon(Icons.security, color: AppColors.gold, size: 56),
              ),
              const SizedBox(height: 10),
              const Center(
                child: Text(
                  'Privacy & Security',
                  style: TextStyle(
                    color: AppColors.gold,
                    fontSize: 26,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ),
              const SizedBox(height: 4),
              const Center(
                child: Text(
                  'Your data stays on your device.',
                  style: TextStyle(color: AppColors.textMuted, fontSize: 13),
                ),
              ),
              const SizedBox(height: 28),

              // ---- SECURITY SECTION ----
              _sectionLabel('Security'),
              const SizedBox(height: 8),

              // PIN toggle
              _toggleCard(
                icon: Icons.pin_outlined,
                title: '6-Digit PIN lock',
                subtitle: _pinEnabled
                    ? 'PIN required to open 1Social'
                    : 'Tap to set a 6-digit PIN',
                value: _pinEnabled,
                onChanged: _savingPin ? null : _togglePin,
              ),
              const SizedBox(height: 8),

              // Face ID toggle
              _toggleCard(
                icon: Icons.face_outlined,
                title: 'Face ID lock',
                subtitle: _faceEnabled
                    ? 'Required to open 1Social'
                    : _biometricAvailable
                    ? 'Tap to require Face ID on open'
                    : 'Face ID not available on this device',
                value: _faceEnabled,
                onChanged: _biometricAvailable ? _toggleFaceId : null,
              ),

              // Stacked auth note
              if (_pinEnabled && _faceEnabled) ...<Widget>[
                const SizedBox(height: 8),
                Container(
                  padding: const EdgeInsets.symmetric(
                    horizontal: 12,
                    vertical: 8,
                  ),
                  decoration: BoxDecoration(
                    color: AppColors.gold.withValues(alpha: 0.06),
                    borderRadius: BorderRadius.circular(10),
                    border: Border.all(
                      color: AppColors.gold.withValues(alpha: 0.3),
                    ),
                  ),
                  child: const Row(
                    children: <Widget>[
                      Icon(Icons.shield, color: AppColors.gold, size: 16),
                      SizedBox(width: 8),
                      Expanded(
                        child: Text(
                          'Face ID first, PIN fallback after 2 failures. '
                          'Maximum security.',
                          style: TextStyle(
                            color: AppColors.textMuted,
                            fontSize: 12,
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
              ],

              // Timeout
              if (_pinEnabled || _faceEnabled) ...<Widget>[
                const SizedBox(height: 10),
                _timeoutCard(),
              ],

              const SizedBox(height: 8),
              // PIN disclaimer note
              Container(
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(
                  color: AppColors.surface,
                  borderRadius: BorderRadius.circular(10),
                  border: Border.all(color: AppColors.border),
                ),
                child: const Text(
                  'Your PIN is stored only on this device in your iPhone\'s '
                  'secure Keychain. 1Social and AppForge LLC have no way to '
                  'unlock the app or recover your PIN. Keep it safe.',
                  style: TextStyle(
                    color: AppColors.textMuted,
                    fontSize: 12,
                    height: 1.45,
                  ),
                ),
              ),

              const SizedBox(height: 28),

              // ---- PRIVACY SECTION ----
              _sectionLabel('The 1Social Promise'),
              const SizedBox(height: 8),
              _promiseCard(),
              const SizedBox(height: 24),

              _sectionLabel('What stays on your device'),
              const SizedBox(height: 8),
              _statusRow(
                icon: Icons.lock_outline,
                title: 'Social media passwords',
                status: 'Never stored',
              ),
              _statusRow(
                icon: Icons.do_not_disturb_on_outlined,
                title: 'Selling your data',
                status: 'Never',
              ),
              _statusRow(
                icon: Icons.visibility_off_outlined,
                title: 'Cross-app tracking',
                status: 'None',
              ),
              _statusRow(
                icon: Icons.edit_note,
                title: 'Drafts',
                status: 'On this device only',
              ),
              _statusRow(
                icon: Icons.history,
                title: 'Share history',
                status: 'On this device only',
              ),
              _statusRow(
                icon: Icons.analytics_outlined,
                title: 'Analytics',
                status: 'Off',
              ),
              const SizedBox(height: 24),

              _sectionLabel('What this means'),
              const SizedBox(height: 8),
              _footnoteCard(),
              const SizedBox(height: 20),

              SizedBox(
                width: double.infinity,
                child: OutlinedButton.icon(
                  onPressed: () => Navigator.of(context).push(
                    MaterialPageRoute<void>(
                      builder: (_) => const PolicyScreen(),
                    ),
